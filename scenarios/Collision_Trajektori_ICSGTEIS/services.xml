<?xml version="1.0" encoding="UTF-8"?>
<services>
    <service type="artery.application.CaService" name="CS">
        <listener port="2001"/>
        <filters>
            <type pattern="artery.inet.Car" match="true"/>
            <type pattern="artery.inet.Person" match="true"/>
        </filters>
    </service>

    <!-- use the correct TrajApp (TrajAppRL or TrajAppKF4D or TrajAppKF6D) -->
    <service type="artery.application.TrajektoriAppKF" name="TrajApp">
        <listener port="2002"/>
        <filters>
            <type pattern="artery.inet.Car" match="true"/>
            <type pattern="artery.inet.Person" match="true"/>
        </filters>
    </service>
</services>
