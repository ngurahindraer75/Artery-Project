<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  =============================================================================
  Extensive Multi-Node Collision Scenario for V2X Trajectory Prediction 
  Generated for Artery, OMNeT++, and SUMO Simulation Framework.

  Note: 
  This file is strictly chronologically sorted by 'depart' time to comply 
  with SUMO's sequential XML parser. It also uses a precise actionStepLength 
  to maintain realistic car-following physics for the Kalman Filter arrays.
  =============================================================================
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <!-- ================================================================== -->
    <!-- 1. ROUTE DEFINITIONS (EXTENSIVE CONTINUOUS LOOPING VIA J5)         -->
    <!-- Description: Continuous loop routes designed to maximize the       -->
    <!-- generation of stochastic conflicts at Ground Zero (J5) from        -->
    <!-- various approach angles, enriching the V2X CAM dataset for LSTM.   -->
    <!-- ================================================================== -->

    <!-- 
      r_0: North-South circulation and West Ring Road
      Path: Enters J5 (East to West) -> West Roundabout -> NW Ring -> North Ring -> Enters J5 (North to South) -> SE Ring -> Returns to East 
    -->
    <route id="r_0" edges="-E8 E4 E2 E6 -E30 E20 E21 E7 -E3 E5 -E12 -E11 -E8"/>

    <!-- 
      r_1: Far-Outer Ring circulation route
      Path: Enters J5 (North to East) -> East Ring -> South Ring -> SW Ring -> Roundabout -> Enters J5 (West to North) 
    -->
    <route id="r_1" edges="-E3 E8 E11 E12 -E15 -E17 -E16 E30 E0 E1 -E4 E3"/>

    <!-- 
      r_2: Figure-8 route intersecting the entire map
      Path: Enters J5 (South to North) -> NE Ring -> Enters J5 (East to West) -> Roundabout -> SW Ring -> SE Ring -> Returns to South 
    -->
    <route id="r_2" edges="-E5 E3 -E10 -E9 -E8 E4 E2 E22 -E21 -E20 E16 E17 E15 -E5"/>

    <!-- 
      r_3: Extreme Rollercoaster route (Starts Far-West, crosses Roundabout, then J5)
      Path: Enters Far-West (E30) -> Roundabout -> Enters J5 (West to East) -> NE Ring -> SE Ring -> Enters J5 (South to North) -> NW Ring -> Returns to West
    -->
    <route id="r_3" edges="E30 E0 E1 -E4 E8 E11 E12 -E5 E3 -E7 -E21 -E20 E30"/>

    <!-- ================================================================== -->
    <!-- ADDITIONAL ROUNDABOUT U-TURN ROUTE DEFINITIONS                     -->
    <!-- Description: 4 routes for vehicles approaching the West roundabout -->
    <!-- from 4 different directions, performing a full 360-degree U-turn,  -->
    <!-- and circulating back via the outer ring road.                      -->
    <!-- ================================================================== -->

    <!-- 
      r_4: East Approach Roundabout 360 U-Turn
      Path: Enters via East (E4) -> Roundabout 360 (E2 E6 E0 E1) -> Exits East (-E4) -> Loops via East Ring -> Returns to E4 
    -->
    <route id="r_4" edges="E4 E2 E6 E0 E1 -E4 E8 E11 E12 -E5 E3 -E10 -E9 -E8 E4"/>

    <!-- 
      r_5: North-East Approach Roundabout 360 U-Turn
      Path: Enters via NE (-E22) -> Roundabout 360 (E6 E0 E1 E2) -> Exits NE (E22) -> Loops via Outer Ring CCW -> Returns to -E22 
    -->
    <route id="r_5" edges="-E22 E6 E0 E1 E2 E22 -E21 -E20 E16 E17 E15 -E12 -E11 E9 E10 -E7 -E22"/>

    <!-- 
      r_6: North-West Approach Roundabout 360 U-Turn
      Path: Enters via NW (E30) -> Roundabout 360 (E0 E1 E2 E6) -> Exits NW (-E30) -> Loops via Outer Ring CW -> Returns to E30 
    -->
    <route id="r_6" edges="E30 E0 E1 E2 E6 -E30 E20 E21 E7 -E10 -E9 E11 E12 -E15 -E17 -E16 E30"/>

    <!-- 
      r_7: South-West Approach Roundabout 360 U-Turn
      Path: Enters via SW (E32) -> Roundabout 360 (E1 E2 E6 E0) -> Exits SW (-E32) -> Loops via Far-South and Ground Zero -> Returns to E32 
    -->
    <route id="r_7" edges="E32 E1 E2 E6 E0 -E32 E14 -E17 -E16 E30 E0 E1 E2 E6 -E30 E20 E21 E7 -E3 E5 -E15 -E14 E32"/>

    <!-- 
      r_8: The Chaotic Erratic Route (Maximum Non-Linearity)
      Path: Enters J5 (East to West) -> Roundabout (Exits NE) -> NW Ring -> Far South Ring -> Roundabout (Exits East) -> Enters J5 (West to South) -> SE Ring -> Returns to J5
    -->
    <route id="r_8" edges="-E8 E4 E2 E22 -E21 -E20 E16 E17 -E14 E32 E1 -E4 E5 -E12 -E11 -E8"/>

    <!-- ================================================================== -->
    <!-- 2. VTYPE DEFINITIONS WITH PSEUDORANDOM DISTRIBUTIONS               -->
    <!-- ================================================================== -->
    
    <!-- Pedestrian Type: Uses a Gaussian distribution for speed to simulate stochastic behavior -->
    <!-- WARNING: Do not add spaces inside normc() to prevent XML schema union errors -->
    <vType id="DEFAULT_PEDTYPE"     minGap="0.00" 
                                    vClass="pedestrian" 
                                    impatience="1.00" 
                                    jmCrossingGap="0.00" 
                                    jmIgnoreFoeProb="1.00" 
                                    sigma="1.00" 
                                    tau="0.50" 
                                    maxSpeed="4.0" 
                                    speedFactor="normc(1.0,0.2,0.5,1.5)"/>
           
    <!-- Vehicle Type: actionStepLength is set to 0.1 to match global step-length and prevent ballistic physics warnings -->
    <vType id="DEFAULT_VEHTYPE"     minGap="0.00" 
                                    latAlignment="center" 
                                    minGapLat="0.5" 
                                    maxSpeedLat="1.5"
                                    actionStepLength="0.1" 
                                    impatience="1.00" 
                                    jmCrossingGap="0" 
                                    jmIgnoreFoeProb="1.0" 
                                    sigma="1.0" 
                                    tau="0.5" 
                                    accel="2.6" 
                                    decel="4.5" 
                                    maxSpeed="15.43" 
                                    speedFactor="normc(1.0,0.1,0.8,1.2)"/>
    
    <!-- ================================================================== -->
    <!-- 3. ENTITY DEFINITIONS (STRICTLY SORTED BY DEPART TIME)             -->
    <!-- Description: All 9 pedestrians spawn at T=0.00s at mid-block       -->
    <!-- positions to ensure prediction algorithms (KF/LSTM) stabilize      -->
    <!-- their covariance/history windows before reaching conflict zones.   -->
    <!-- Vehicles are scheduled to intercept them precisely at the zones.   -->
    <!-- ================================================================== -->
    
    <!-- ================== ALL PEDESTRIANS SPAWN (0.00s) ================= -->
    <person id="p_0" depart="0.00" departPos="50.0">
        <!-- Spawns mid-block on -E8. Intersects J5 at ~T=21s -->
        <walk edges="-E8 E3 -E7 -E21 -E20 E16 E17 E15 -E12 -E11"/>
    </person>
    <person id="p_1" depart="0.00" departPos="65.0">
        <!-- Spawns closer to J5 on -E8. Intersects J5 at ~T=10s -->
        <walk edges="-E8 E5 -E15 -E17 -E16 E30 E0 E1 -E4"/>
    </person>
    <person id="p_2" depart="0.00" departPos="30.0">
        <!-- Spawns far back on -E8. Intersects J5 at ~T=36s -->
        <walk edges="-E8 E4 E2 E6 -E30 E20 E21 E7 -E3"/>
    </person>
    <person id="p_3" depart="0.00" departPos="110.0">
        <!-- Spawns mid-block on West approach -E4. Intersects J5 at ~T=35s -->
        <walk edges="-E4 E8 E11 E12 -E5 E3 -E7 -E22 E6 E0 E1"/>
    </person>
    
    <person id="p_4" depart="0.00" departPos="140.0">
        <!-- Spawns far mid-block on NW Ring E30. Reaches Roundabout at ~T=45s -->
        <walk edges="E30 E0 E1 -E4 E8 E11 E12 -E5 E4"/>
    </person>
    <person id="p_5" depart="0.00" departPos="112.0">
        <!-- Spawns far mid-block on NE Ring -E22. Reaches Roundabout at ~T=46s -->
        <walk edges="-E22 E6 E0 E1 -E4 E8 E11 E12 -E5"/>
    </person>
    <person id="p_6" depart="0.00" departPos="97.0">
        <!-- Spawns far mid-block on SE approach E4. Reaches Roundabout at ~T=45s -->
        <walk edges="E4 E2 E6 -E30 E20 E21 E7 -E3 E8"/>
    </person>
    <person id="p_7" depart="0.00" departPos="78.0">
        <!-- Spawns mid-block on SW approach E32. Reaches Roundabout at ~T=45s -->
        <walk edges="E32 E1 E2 E6 E0 -E32 E14 -E17 -E16"/>
    </person>
    <person id="p_8" depart="0.00" departPos="71.0">
        <!-- Spawns far mid-block on West -E4. Intersects Ground Zero J5 at ~T=65s -->
        <walk edges="-E4 E8 E11 E12 -E5 E3 E7 E21 E20 -E30"/>
    </person>

    <!-- ================== VEHICLES SPAWN & INTERCEPT ==================== -->
    
    <!-- === TIMESTEP: 4.00s (Intercepts p_1 at J5) === -->
    <vehicle id="v_0" depart="4.00" route="r_0" departSpeed="max">
        <stop lane="-E8_1" endPos="75.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 8.50s (Intercepts p_0 at J5) === -->
    <vehicle id="v_2" depart="8.50" route="r_1" departSpeed="max">
        <stop lane="-E3_1" endPos="170.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 23.50s (Intercepts p_2 at J5) === -->
    <vehicle id="v_3" depart="23.50" route="r_2" departSpeed="max">
        <stop lane="-E5_1" endPos="170.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 24.00s (Intercepts p_3 at J5) === -->
    <vehicle id="v_1" depart="24.00" route="r_3" departSpeed="max">
        <stop lane="-E4_1" endPos="150.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 31.00s (Roundabout 360 U-Turn Ambush 1) === -->
    <vehicle id="v_6" depart="31.00" route="r_6" departSpeed="max">
        <stop lane="E30_1" endPos="190.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 33.00s (Roundabout 360 U-Turn Ambush 2) === -->
    <vehicle id="v_5" depart="33.00" route="r_5" departSpeed="max">
        <stop lane="-E22_1" endPos="160.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 34.00s (Roundabout 360 U-Turn Ambush 3) === -->
    <vehicle id="v_4" depart="34.00" route="r_4" departSpeed="max">
        <stop lane="E4_1" endPos="145.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 35.50s (Roundabout 360 U-Turn Ambush 4) === -->
    <vehicle id="v_7" depart="35.50" route="r_7" departSpeed="max">
        <stop lane="E32_1" endPos="125.0" duration="0.5"/>
    </vehicle>

    <!-- === TIMESTEP: 58.00s (The Chaos Vehicle intercepts p_8 at J5) === -->
    <vehicle id="v_8" depart="58.00" route="r_8" departSpeed="max">
        <!-- Multiple stutters before hitting J5 to challenge LSTM vs KF -->
        <stop lane="-E8_1" endPos="75.0" duration="0.2"/>
        <stop lane="E4_1" endPos="150.0" duration="0.3"/>
        <stop lane="-E4_1" endPos="145.0" duration="0.5"/>
    </vehicle>

</routes>
